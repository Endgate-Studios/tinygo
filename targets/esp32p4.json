{
	"inherits": [
		"riscv32"
	],
	"inheritable-only": true,
	"features": "+32bit,+a,+c,+m,+zaamo,+zalrsc,+zmmul,-relax",
	"build-tags": [
		"esp32p4",
		"esp"
	],
	"serial": "uart",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 8192,
	"linkerscript": "targets/esp32p4.ld",
	"extra-files": [
		"src/device/esp/esp32p4.S"
	],
	"binary-format": "esp32p4",
	"flash-method": "esp32flash",
	"gdb": [
		"riscv32-esp-elf-gdb"
	]
}
