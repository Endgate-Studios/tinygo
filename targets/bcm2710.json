{
	"llvm-target": "aarch64-unknown-none",
	"cpu": "cortex-a53",
	"features": "+crc,+fp-armv8,+neon,+v8a,-fmv",
	"build-tags": ["bcm2710", "baremetal", "linux", "arm64"],
	"goos": "linux",
	"goarch": "arm64",
	"gc": "conservative",
	"scheduler": "tasks",
	"serial": "uart",
	"linker": "ld.lld",
	"rtlib": "compiler-rt",
	"libc": "picolibc",
	"default-stack-size": 16384,
	"cflags": [
		"-target", "aarch64-unknown-none",
		"-mcpu=cortex-a53",
		"-Werror",
		"-fshort-enums",
		"-fomit-frame-pointer",
		"-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
		"-ffunction-sections", "-fdata-sections"
	],
	"ldflags": [
		"--gc-sections"
	],
	"linkerscript": "targets/bcm2710.ld",
	"extra-files": [
		"src/device/bcm2710/start.S",
		"src/internal/task/task_stack_arm64.S",
		"src/runtime/asm_arm64.S"
	]
}
